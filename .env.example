TELEGRAM_BOT_TOKEN=123456:ABC...
REDIS_URL=redis://redis:6379/0

# S3-compatible storage (Garage, SeaweedFS, MinIO, R2, ...). Bucket must exist.
S3_ENDPOINT=https://s3.example.ch
S3_BUCKET=tiktok-vault
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=garage
# Needed only for video_mode=external / auto on free Notion plans: public, stable URL that maps to the bucket root.
# e.g. reverse proxy https://media.example.ch/tiktok-vault/<key> -> bucket object
PUBLIC_MEDIA_BASE_URL=

# Vision + extraction model, any OpenAI-compatible chat endpoint that accepts images.
# OpenRouter:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=google/gemini-2.5-flash
# Local example (vLLM / Ollama):
# LLM_BASE_URL=http://gpu-box:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# Speech-to-text, OpenAI-compatible /audio/transcriptions. Leave STT_BASE_URL empty to skip.
STT_BASE_URL=http://gpu-box:8000/v1
STT_API_KEY=none
STT_MODEL=Systran/faster-whisper-large-v3

# Optional, Netscape cookies.txt from a logged-in browser (helps with age-gated/region-locked posts)
TIKTOK_COOKIES_FILE=
MAX_FRAMES=10
WORKER_CONCURRENCY=2

# Referenced from profiles.yaml
NOTION_TOKEN_NILS=ntn_...
NOTION_TOKEN_PARTNER=ntn_...
